{
  "id": "file-persistence-app",
  "triggers": [],
  "entry": "writer",
  "inputs": {
    "path": "string",
    "value": "any"
  },
  "outputs": {
    "value": "any"
  },
  "steps": [
    {
      "id": "writer",
      "use": "file.write",
      "config": {
        "overwrite": true
      },
      "on": {
        "written": "reader",
        "conflict": "reader",
        "rejected": "reader"
      }
    },
    {
      "id": "reader",
      "use": "file.read",
      "config": {
        "format": "json"
      },
      "on": {
        "read": "deleter",
        "missing": "deleter",
        "rejected": "deleter"
      }
    },
    {
      "id": "deleter",
      "use": "file.delete",
      "config": {},
      "on": {
        "deleted": "end",
        "missing": "end",
        "rejected": "end"
      }
    }
  ],
  "connections": [
    {
      "from": "input.path",
      "to": "writer.path"
    },
    {
      "from": "input.value",
      "to": "writer.value"
    },
    {
      "from": "input.path",
      "to": "reader.path"
    },
    {
      "from": "reader.value",
      "to": "output.value"
    },
    {
      "from": "input.path",
      "to": "deleter.path"
    }
  ]
}
