{
  "id": "file-read-app",
  "triggers": [],
  "entry": "reader",
  "inputs": {
    "path": "string"
  },
  "outputs": {
    "value": "any"
  },
  "steps": [
    {
      "id": "reader",
      "use": "file.read",
      "config": {
        "format": "yaml"
      },
      "on": {
        "read": "end",
        "missing": "end",
        "rejected": "end"
      }
    }
  ],
  "connections": [
    {
      "from": "input.path",
      "to": "reader.path"
    },
    {
      "from": "reader.value",
      "to": "output.value"
    }
  ]
}
