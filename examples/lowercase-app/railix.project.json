{
  "format": 1,
  "id": "atomic-byte-forge",
  "links": [
    {
      "from": "app.start",
      "to": "command"
    },
    {
      "from": "command.next",
      "to": "lowercase-text"
    },
    {
      "from": "lowercase-text.ok",
      "to": "end"
    }
  ],
  "nodes": [
    {
      "id": "app",
      "inputs": {},
      "use": "railix.app"
    },
    {
      "examples": [
        {
          "name": "hello",
          "payload": [
            "Hello RAILIX"
          ]
        }
      ],
      "id": "command",
      "inputs": {
        "target": [
          "context",
          "payload",
          "arguments"
        ]
      },
      "use": "railix.trigger.cli"
    },
    {
      "id": "lowercase-text",
      "inputs": {},
      "receives": {
        "value": [
          "context",
          "payload",
          "arguments",
          0
        ]
      },
      "returns": {
        "value": [
          "context",
          "result"
        ]
      },
      "use": "text.lowercase"
    }
  ]
}
