{
  "id": "trusted-greeting",
  "triggers": [
    {
      "id": "command",
      "type": "cli",
      "config": {
        "stdin": true
      }
    },
    {
      "id": "greet",
      "type": "http",
      "config": {
        "port": 18080,
        "path": "/greet"
      }
    },
    {
      "id": "flow-events",
      "type": "http",
      "config": {
        "port": 18080,
        "flow": true
      }
    },
    {
      "id": "prefix-events",
      "type": "http",
      "config": {
        "port": 18080,
        "step": "prefix"
      }
    },
    {
      "id": "socket-events",
      "type": "socket",
      "config": {
        "port": 18081,
        "timeoutMillis": 30000,
        "maxConnections": 32
      }
    }
  ],
  "entry": "lowercase",
  "inputs": {
    "name": "string"
  },
  "outputs": {
    "message": "string"
  },
  "steps": [
    {
      "id": "lowercase",
      "use": "text.lowercase",
      "config": {},
      "on": {
        "ok": "prefix"
      }
    },
    {
      "id": "prefix",
      "use": "example.text.prefix",
      "config": {},
      "on": {
        "ok": "end"
      }
    }
  ],
  "connections": [
    {
      "from": "input.name",
      "to": "lowercase.text"
    },
    {
      "from": "lowercase.text",
      "to": "prefix.text"
    },
    {
      "from": "prefix.text",
      "to": "output.message"
    }
  ]
}
